# ─── PostgreSQL ────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=farmvaidya
POSTGRES_USER=farmvaidya
POSTGRES_PASSWORD=changeme

# ─── Google Cloud / Vertex AI ──────────────────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=asia-south1
# Path to service account JSON (inside container: /app/credentials/sa.json)
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/sa.json

# ─── LLM (Gemini 2.5 Flash via Vertex AI) ──────────────────
LLM_MODEL=gemini-2.5-flash
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.1

# ─── STT (Soniox — Telugu) ─────────────────────────────────
SONIOX_API_KEY=your-soniox-api-key

# ─── TTS (Cartesia — Telugu voice) ─────────────────────────
CARTESIA_API_KEY=your-cartesia-api-key
CARTESIA_TELUGU_VOICE_ID=your-telugu-voice-id

# ─── Telephony (Tata Tele Business Services) ───────────────
TATA_TELE_API_KEY=your-tata-tele-api-key
TATA_TELE_ENDPOINT=wss://your-tata-tele-endpoint
TATA_TELE_DID_NUMBER=+91XXXXXXXXXX

# ─── RAG ───────────────────────────────────────────────────
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.65
EMBEDDING_MODEL=text-multilingual-embedding-002

# ─── Server ────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8765

# ─── Logging ───────────────────────────────────────────────
LOG_LEVEL=INFO
